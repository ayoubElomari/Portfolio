{
  "rendr": "v2.1.0",
  "settings": {
    "fps": 60,
    "resolution": [
      1080,
      1920
    ]
  },
  "variables": {
    "ink": "#f6f2ec",
    "accent": "#b98cff",
    "deep": "#0a0614",
    "display": "Akshar, system-ui, sans-serif",
    "ui": "Inter, system-ui, sans-serif"
  },
  "assets": {
    "media": {
      "hook": {
        "type": "video",
        "src": "broll-hook.mp4"
      },
      "machine": {
        "type": "video",
        "src": "broll-cutaway.mp4"
      },
      "sky": {
        "type": "image",
        "src": "insert-photo.jpg"
      }
    }
  },
  "presets": {
    "tag": {
      "&": {
        "fontFamily": "@variables:ui",
        "fontWeight": 600,
        "textTransform": "uppercase",
        "color": "@variables:accent"
      }
    }
  },
  "components": {
    "statRow": {
      "parameters": {
        "value": {
          "type": "string",
          "required": true
        },
        "label": {
          "type": "string",
          "required": true
        },
        "x": {
          "type": "number",
          "required": true
        },
        "y": {
          "type": "number",
          "required": true
        },
        "w": {
          "type": "number",
          "required": true
        }
      },
      "timeline": [
        {
          "id": "stat-rule",
          "type": "Text",
          "config": {
            "content": ""
          },
          "style": {
            "&": {
              "position": "absolute",
              "left": "{{x}}px",
              "top": "{{y}}px",
              "height": "1px",
              "zIndex": 60,
              "backgroundColor": "@variables:accent",
              "opacity": 0.42,
              "width": {
                "keyframes": [
                  {
                    "at": "0%",
                    "value": "0px",
                    "easing": "easeOutExpo"
                  },
                  {
                    "at": "40%",
                    "value": "{{w}}px"
                  },
                  {
                    "at": "100%",
                    "value": "{{w}}px"
                  }
                ]
              }
            }
          }
        },
        {
          "id": "stat-value",
          "type": "Text",
          "config": {
            "content": "{{value}}"
          },
          "style": {
            "&": {
              "position": "absolute",
              "left": "{{x}}px",
              "top": "calc({{y}}px + 26px)",
              "width": "{{w}}px",
              "zIndex": 61,
              "fontFamily": "@variables:display",
              "fontSize": "168px",
              "fontWeight": 600,
              "lineHeight": "1",
              "color": "@variables:ink",
              "opacity": {
                "keyframes": [
                  {
                    "at": "0%",
                    "value": 0,
                    "easing": "easeOutCubic"
                  },
                  {
                    "at": "14%",
                    "value": 1
                  },
                  {
                    "at": "90%",
                    "value": 1,
                    "easing": "easeInCubic"
                  },
                  {
                    "at": "100%",
                    "value": 0
                  }
                ]
              },
              "transform": {
                "keyframes": [
                  {
                    "at": "0%",
                    "value": "translateY(22px)",
                    "easing": "easeOutExpo"
                  },
                  {
                    "at": "34%",
                    "value": "translateY(0px)"
                  },
                  {
                    "at": "100%",
                    "value": "translateY(0px)"
                  }
                ]
              }
            }
          }
        },
        {
          "id": "stat-label",
          "type": "Text",
          "stylePreset": "@presets:tag",
          "config": {
            "content": "{{label}}"
          },
          "style": {
            "&": {
              "position": "absolute",
              "left": "{{x}}px",
              "top": "calc({{y}}px + 212px)",
              "width": "{{w}}px",
              "zIndex": 61,
              "fontSize": "24px",
              "letterSpacing": "0.3em",
              "opacity": {
                "keyframes": [
                  {
                    "at": "0%",
                    "value": 0,
                    "easing": "easeOutCubic"
                  },
                  {
                    "at": "22%",
                    "value": 1
                  },
                  {
                    "at": "90%",
                    "value": 1,
                    "easing": "easeInCubic"
                  },
                  {
                    "at": "100%",
                    "value": 0
                  }
                ]
              }
            }
          }
        }
      ]
    }
  },
